{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "A client of the agency",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Client name" },
        "company": { "type": "string", "description": "Company name" },
        "companyId": { "type": "string", "description": "Reference to the company" },
        "status": { "type": "string", "enum": ["active", "inactive"], "description": "Client status" },
        "joinedAt": { "type": "string", "format": "date-time", "description": "When the client joined" },
        "category": { "type": "string", "enum": ["agency", "hosting"], "description": "Client category (agency or hosting)" },
        "type": { "type": "string", "enum": ["recurrent", "project", "both"], "description": "Type of client" },
        "userId": { "type": "string", "description": "Owner of this client record" }
      },
      "required": ["name", "company", "companyId", "status", "joinedAt", "category", "type", "userId"]
    },
    "Contract": {
      "title": "Contract",
      "description": "A recurrent contract with a client",
      "type": "object",
      "properties": {
        "clientId": { "type": "string", "description": "Reference to the client" },
        "companyId": { "type": "string", "description": "Reference to the company" },
        "monthlyValue": { "type": "number", "description": "Monthly value of the contract" },
        "service": { "type": "string", "description": "Service provided" },
        "category": { "type": "string", "enum": ["recurrence", "hosting"], "description": "Contract category" },
        "startDate": { "type": "string", "format": "date-time", "description": "Contract start date" },
        "status": { "type": "string", "enum": ["active", "cancelled"], "description": "Contract status" },
        "userId": { "type": "string", "description": "Owner of this contract record" }
      },
      "required": ["clientId", "companyId", "monthlyValue", "service", "startDate", "status", "userId"]
    },
    "Project": {
      "title": "Project",
      "description": "A one-time project for a client",
      "type": "object",
      "properties": {
        "clientId": { "type": "string", "description": "Reference to the client" },
        "companyId": { "type": "string", "description": "Reference to the company" },
        "name": { "type": "string", "description": "Project name" },
        "type": { "type": "string", "enum": ["Site", "Landing Page", "Branding", "Automação", "GMN Cadastro", "GMN Atualização"], "description": "Project type" },
        "value": { "type": "number", "description": "Total project value" },
        "status": { "type": "string", "enum": ["negotiation", "execution", "delivered", "delayed"], "description": "Project status" },
        "startDate": { "type": "string", "format": "date-time", "description": "Project start date" },
        "deadline": { "type": "string", "format": "date-time", "description": "Project deadline" },
        "deliveryDate": { "type": "string", "format": "date-time", "description": "Actual delivery date" },
        "userId": { "type": "string", "description": "Owner of this project record" }
      },
      "required": ["clientId", "companyId", "name", "type", "value", "status", "startDate", "userId"]
    },
    "FinancialEntry": {
      "title": "FinancialEntry",
      "description": "A financial transaction record",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["income"], "description": "Transaction type" },
        "value": { "type": "number", "description": "Transaction value" },
        "companyId": { "type": "string", "description": "Reference to the company" },
        "source": { "type": "string", "enum": ["recurrent", "project", "hosting"], "description": "Revenue source" },
        "date": { "type": "string", "format": "date-time", "description": "Transaction date" },
        "userId": { "type": "string", "description": "Owner of this financial record" }
      },
      "required": ["type", "value", "companyId", "source", "date", "userId"]
    },
    "CommercialStats": {
      "title": "CommercialStats",
      "description": "Monthly commercial performance metrics",
      "type": "object",
      "properties": {
        "leads": { "type": "integer", "description": "Number of leads" },
        "meetings": { "type": "integer", "description": "Number of meetings" },
        "proposals": { "type": "integer", "description": "Number of proposals" },
        "sales": { "type": "integer", "description": "Number of sales" },
        "companyId": { "type": "string", "description": "Reference to the company" },
        "conversionRate": { "type": "number", "description": "Conversion rate percentage" },
        "month": { "type": "string", "description": "Month identifier (e.g., Jan)" },
        "userId": { "type": "string", "description": "Owner of this record" }
      },
      "required": ["leads", "meetings", "proposals", "sales", "companyId", "conversionRate", "month", "userId"]
    },
    "Lead": {
      "title": "Lead",
      "description": "A sales lead in the pipeline",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Lead name" },
        "company": { "type": "string", "description": "Company name" },
        "companyId": { "type": "string", "description": "Reference to the company" },
        "phone": { "type": "string", "description": "Phone number" },
        "email": { "type": "string", "description": "Email address" },
        "source": { "type": "string", "description": "Lead source" },
        "value": { "type": "number", "description": "Potential value" },
        "status": { "type": "string", "enum": ["lead", "contact", "meeting", "proposal", "won", "lost"], "description": "Pipeline status" },
        "owner": { "type": "string", "description": "Responsible person" },
        "notes": { "type": "string", "description": "Observations" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation date" },
        "userId": { "type": "string", "description": "Owner of this lead record" }
      },
      "required": ["name", "company", "companyId", "status", "createdAt", "userId"]
    },
    "Company": {
      "title": "Company",
      "description": "A company managed by the user",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Company name" },
        "userId": { "type": "string", "description": "Owner of this company record" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation date" }
      },
      "required": ["name", "userId", "createdAt"]
    },
    "Task": {
      "title": "Task",
      "description": "A task in the project management system",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Task title" },
        "description": { "type": "string", "description": "Task description" },
        "status": { "type": "string", "enum": ["todo", "in-progress", "review", "done"], "description": "Task status" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"], "description": "Task priority" },
        "companyId": { "type": "string", "description": "Reference to the company" },
        "userId": { "type": "string", "description": "Owner of this task record" },
        "clientId": { "type": "string", "description": "Reference to the client" },
        "serviceId": { "type": "string", "description": "Reference to the service" },
        "serviceName": { "type": "string", "description": "Name of the service" },
        "processId": { "type": "string", "description": "Reference to the source process/SOP" },
        "processTitle": { "type": "string", "description": "Title of the source process" },
        "processStepId": { "type": "string", "description": "Step ID in the source process" },
        "processStepOrder": { "type": "integer", "description": "Step order in the process" },
        "processStepTitle": { "type": "string", "description": "Title of the process step" },
        "source": { "type": "string", "enum": ["manual", "project", "process"], "description": "Task creation origin" },
        "responsibleRole": { "type": "string", "description": "Responsible role for the task" },
        "dueDate": { "type": "string", "format": "date-time", "description": "Task due date" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation date" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update date" }
      },
      "required": ["title", "status", "priority", "companyId", "userId", "createdAt"]
    },
    "Process": {
      "title": "Process",
      "description": "Standard operating procedure (SOP) or workflow checklist",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Process title" },
        "description": { "type": "string", "description": "Process description" },
        "category": { "type": "string", "description": "Process category" },
        "department": { "type": "string", "description": "Department" },
        "serviceId": { "type": "string", "description": "Associated service ID" },
        "serviceName": { "type": "string", "description": "Associated service name" },
        "active": { "type": "boolean", "description": "Whether process is active" },
        "content": { "type": "string", "description": "Detailed process documentation content" },
        "steps": {
          "type": "array",
          "description": "List of checklist steps in the process",
          "items": { "type": "object" }
        },
        "companyId": { "type": "string", "description": "Reference to company" },
        "userId": { "type": "string", "description": "Owner of this process" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation date" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update date" }
      },
      "required": ["title", "category", "companyId", "userId", "createdAt"]
    },
    "Onboarding": {
      "title": "Onboarding",
      "description": "Client onboarding workflow execution",
      "type": "object",
      "properties": {
        "clientId": { "type": "string", "description": "Reference to client" },
        "companyId": { "type": "string", "description": "Reference to company" },
        "userId": { "type": "string", "description": "Owner of this onboarding" },
        "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "paused", "cancelled"], "description": "Onboarding status" },
        "currentStep": { "type": "integer", "description": "Index of current step" },
        "steps": {
          "type": "array",
          "description": "Steps in the onboarding process",
          "items": { "type": "object" }
        },
        "startedAt": { "type": "string", "format": "date-time", "description": "Start date" },
        "completedAt": { "type": "string", "format": "date-time", "description": "Completion date" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation date" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update date" }
      },
      "required": ["clientId", "companyId", "userId", "status", "createdAt"]
    },
    "Service": {
      "title": "Service",
      "description": "A service offered by the agency",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Service name" },
        "description": { "type": "string", "description": "Service description" },
        "category": { "type": "string", "description": "Service category" },
        "active": { "type": "boolean", "description": "Whether service is actively offered" },
        "companyId": { "type": "string", "description": "Reference to company" },
        "userId": { "type": "string", "description": "Owner of this service record" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation date" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update date" }
      },
      "required": ["name", "active", "companyId", "userId", "createdAt"]
    },
    "ClientService": {
      "title": "ClientService",
      "description": "Relationship between an existing client and an active agency service",
      "type": "object",
      "properties": {
        "clientId": { "type": "string", "description": "Reference to client" },
        "serviceId": { "type": "string", "description": "Reference to service" },
        "companyId": { "type": "string", "description": "Reference to company" },
        "userId": { "type": "string", "description": "Owner of this record" },
        "status": { "type": "string", "enum": ["active", "paused", "cancelled", "completed"], "description": "Client service status" },
        "startDate": { "type": "string", "format": "date-time", "description": "Start date" },
        "endDate": { "type": "string", "format": "date-time", "description": "End date" },
        "notes": { "type": "string", "description": "Additional notes" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation date" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update date" }
      },
      "required": ["clientId", "serviceId", "companyId", "userId", "status", "createdAt"]
    }
  },
  "firestore": {
    "clients": { "schema": { "$ref": "Client" }, "description": "Collection of clients" },
    "contracts": { "schema": { "$ref": "Contract" }, "description": "Collection of contracts" },
    "projects": { "schema": { "$ref": "Project" }, "description": "Collection of projects" },
    "financial": { "schema": { "$ref": "FinancialEntry" }, "description": "Collection of financial entries" },
    "commercial": { "schema": { "$ref": "CommercialStats" }, "description": "Collection of commercial stats" },
    "leads": { "schema": { "$ref": "Lead" }, "description": "Collection of sales leads" },
    "companies": { "schema": { "$ref": "Company" }, "description": "Collection of companies" },
    "tasks": { "schema": { "$ref": "Task" }, "description": "Collection of tasks" },
    "processes": { "schema": { "$ref": "Process" }, "description": "Collection of processes / SOPs" },
    "onboardings": { "schema": { "$ref": "Onboarding" }, "description": "Collection of client onboardings" },
    "services": { "schema": { "$ref": "Service" }, "description": "Collection of agency services" },
    "clientServices": { "schema": { "$ref": "ClientService" }, "description": "Collection of services assigned to clients" }
  }
}
